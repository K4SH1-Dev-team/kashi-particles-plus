{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dsl:wind_3_1_p",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/slash"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 600,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.2
			},
			"minecraft:emitter_shape_sphere": {
				"offset": ["math.cos(230+variable.emitter_age*800)*(1.5+variable.emitter_age*4)", "-0.5+math.cos(90+variable.emitter_age*800)*-0.8", "math.sin(230+variable.emitter_age*800)*(-1.5-variable.emitter_age*4)"],
				"radius": "0.5+variable.emitter_age",
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "variable.particle_random_3 * 0.5"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,360)",
				"rotation_rate": 10
			},
			"minecraft:particle_initial_speed": 3,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.2+variable.particle_random_1*0.2+(variable.emitter_age*0.5)", "0.1+variable.particle_random_1*0.2+(variable.emitter_age*0.5)"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 420,
					"texture_height": 60,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [60, 60],
						"step_UV": [60, 0],
						"max_frame": 7,
						"stretch_to_lifetime": true,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FF00FF72",
						"1.0": "#0000FF72"
					}
				}
			}
		}
	}
}
